# Copiar a .env y completar. En Render se definen como Environment Variables.
# Nunca subir el .env a git (ya está en .gitignore).

# ---------------------------------------------------------------- Base y sesión
# URL de Postgres. Desde fuera de Render usar la "External Database URL".
DATABASE_URL=postgresql://usuario:clave@host:5432/arianna
# Secreto para firmar los JWT de sesión (cadena larga y aleatoria).
JWT_SECRET=cambiar-por-una-cadena-larga-y-aleatoria
# Días que dura la sesión.
JWT_DAYS=30
# true solo en desarrollo: habilita POST /auth/dev (login sin contraseña). En producción: false.
ALLOW_DEV_LOGIN=false
# Client ID "Web" de Google Cloud, para "Iniciar sesión con Google" (vacío = desactivado).
GOOGLE_CLIENT_ID=
# Zona horaria para saber qué día es "hoy" (el servidor corre en UTC).
APP_TIMEZONE=America/Guayaquil

# ---------------------------------------------------------------- Invitaciones
# Días que dura un código de invitación.
INVITE_DAYS=7
# Base del enlace que se comparte. Tiene que ser https para que WhatsApp lo vuelva tocable.
INVITE_URL_BASE=https://garage-back-me4r.onrender.com/join/
# App Links (/.well-known/assetlinks.json): paquete y huellas SHA-256 de la firma (separadas por coma).
ANDROID_PACKAGE=com.arianna.app
ANDROID_CERT_SHA256=F5:D4:90:EA:DE:AC:49:D1:58:DC:A9:FC:02:18:18:82:15:FD:80:E0:9C:93:39:0B:8D:58:0D:59:AB:15:5E:85

# ---------------------------------------------------------------- Códigos por correo (OTP)
# true: crear cuenta exige el código enviado al correo.
REQUIRE_EMAIL_VERIFICATION=true
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_RESEND_SECONDS=60
CODE_MAX_PER_HOUR=5

# ---------------------------------------------------------------- Correos
# console (el código sale en los logs) o brevo (API HTTP; Render Free bloquea SMTP). Ver docs/DEPLOY.md.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Arianna

# ---------------------------------------------------------------- Fotos (S3: Supabase Storage, Cloudflare R2…)
STORAGE_ENDPOINT=https://<proyecto>.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_KEY_ID=
STORAGE_SECRET=
# Tamaño máximo por foto y espacio por dueño (bytes): 2 MB y 200 MB.
MAX_IMAGE_BYTES=2097152
MAX_STORAGE_BYTES_PER_OWNER=209715200
# Segundos que dura el enlace firmado para ver una foto.
SIGNED_URL_SECONDS=3600

# ---------------------------------------------------------------- Notificaciones push
# console (se escriben en los logs) o fcm (Firebase Cloud Messaging). Ver docs/DEPLOY.md.
PUSH_PROVIDER=console
# JSON completo de la cuenta de servicio de Firebase (en una sola línea).
FIREBASE_SERVICE_ACCOUNT=
