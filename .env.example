# Copiar a .env y completar. En Render se definen como Environment Variables.
# URL de Postgres. Desde fuera de Render usar la "External Database URL".
DATABASE_URL=postgresql://usuario:password@host:5432/base
# Secreto para firmar los JWT de sesión (cadena larga y aleatoria).
JWT_SECRET=cambia-esto
# true solo en desarrollo: habilita POST /auth/dev (login sin Google).
ALLOW_DEV_LOGIN=false
# Client ID "Web" de Google Cloud, para validar los ID tokens de "Iniciar sesión con Google".
GOOGLE_CLIENT_ID=
# Envío de correos: console (código en logs) o brevo. Ver docs/DEPLOY.md.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Garaje
# true: crear cuenta exige el código enviado al correo.
REQUIRE_EMAIL_VERIFICATION=true
